# EduPulse AI — Local Development Environment
# Copy this file to `.env` and adjust values. Never commit `.env`.

# --- PostgreSQL ---
POSTGRES_USER=edupulse
POSTGRES_PASSWORD=edupulse
POSTGRES_DB=edupulse
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API (FastAPI) ---
API_PORT=8000
# Full DSN used by the api service; Docker Compose overrides this to point at
# the `postgres` service hostname, but it must be set for local (non-docker)
# `uvicorn` runs too.
DATABASE_URL=postgresql+psycopg://edupulse:edupulse@localhost:5432/edupulse
REDIS_URL=redis://localhost:6379/0
# Used only by the pytest suite (tests/conftest.py), never by the running
# app, so `make test` cannot write rows into your real local data. Docker
# Compose points this at a dedicated `edupulse_test` database created once by
# infrastructure/postgres/init/01-create-test-db.sql (fresh volumes only —
# see README for how to create it on an existing volume).
TEST_DATABASE_URL=postgresql+psycopg://edupulse:edupulse@localhost:5432/edupulse_test
TEST_REDIS_URL=redis://localhost:6379/15
# Comma-separated list of allowed CORS origins for local development.
API_CORS_ORIGINS=http://localhost:3000
# Secret used to sign auth tokens. MUST be replaced with a real random value
# before any non-local use. Never commit a real value here.
API_SECRET_KEY=change-me-in-local-env

# --- AI Gateway / Ollama (§44 local-first) ---
OLLAMA_PORT=11434
# Base URL the API server uses to reach Ollama. This default is for running
# the API natively (non-Docker) against a host-installed Ollama. Docker
# Compose overrides this to http://host.docker.internal:11434 for the `api`
# service (see docker-compose.yml) — `localhost` inside a container is the
# container itself, not the host, confirmed by a real test (ADR-015
# addendum). Ollama is an optional, degrade-gracefully dependency (§43),
# not started or pulled by default either way.
OLLAMA_BASE_URL=http://localhost:11434
# 1-3B parameter models are the realistic default for CPU-only local dev —
# real-hardware testing (ADR-015 addendum) found an 8B model impractical on
# a modest 4-core/8-thread mobile CPU with no usable GPU acceleration.
OLLAMA_MODEL=llama3.2:1b
AI_REQUEST_TIMEOUT_SECONDS=30.0

# --- Model Router: optional second provider (§140, ADR-022) ---
# Empty by default — no external AI call happens unless you deliberately
# set all three (§136). Ollama stays the primary provider either way; this
# is a fallback tried only after Ollama fails, never a replacement. Any
# OpenAI Chat-Completions-API-compatible endpoint works: OpenAI itself,
# Groq, Together, OpenRouter, DeepSeek, a self-hosted vLLM/LM Studio
# instance, etc.
SECONDARY_AI_PROVIDER_BASE_URL=
SECONDARY_AI_PROVIDER_API_KEY=
SECONDARY_AI_PROVIDER_MODEL=
# Recorded on AIUsageRecord.provider so a fallback call is distinguishable
# from Ollama in cost/usage accounting — set to something meaningful for
# whichever service you actually configure (e.g. "groq", "openai").
SECONDARY_AI_PROVIDER_NAME=openai_compatible

# --- Mailpit (local-dev-only SMTP catcher, §9-11 local-first — password
# reset emails land here, never a real inbox; read them at
# http://localhost:8025) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
# Overridden by docker-compose.yml to host `mailpit`/port 1025 for the `api`
# service; these defaults are for running the API natively (non-Docker).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_ADDRESS=no-reply@edupulse.local
# Used to build the link inside password-reset emails
# (http://<WEB_BASE_URL>/reset-password?token=...). Must point at wherever
# the web app is actually reachable from the browser, not from inside a
# container.
WEB_BASE_URL=http://localhost:3000

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- n8n (§92 workflows/scheduled tasks — e.g. the retention-checkpoint
# poller, infrastructure/n8n/workflows/retention-checkpoint-scheduler.json) ---
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
# MUST be replaced with real random values before any non-local use (§79).
N8N_BASIC_AUTH_PASSWORD=change-me-in-local-env
N8N_ENCRYPTION_KEY=change-me-in-local-env
N8N_TIMEZONE=UTC
# Credentials for the dedicated staff account the scheduler workflow logs in
# as (create it with scripts/seed_retention_scheduler_account.py — a real
# TEACHER account scoped to one tenant, not a special auth mechanism).
# Leave blank to leave the scheduler workflow inert.
RETENTION_SCHEDULER_EMAIL=
RETENTION_SCHEDULER_PASSWORD=
