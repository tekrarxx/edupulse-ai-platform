# EduPulse AI — Local Development Environment
# Copy this file to `.env` and adjust values. Never commit `.env`.

# --- PostgreSQL ---
POSTGRES_USER=edupulse
POSTGRES_PASSWORD=edupulse
POSTGRES_DB=edupulse
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API (FastAPI) ---
API_PORT=8000
# Full DSN used by the api service; Docker Compose overrides this to point at
# the `postgres` service hostname, but it must be set for local (non-docker)
# `uvicorn` runs too.
DATABASE_URL=postgresql+psycopg://edupulse:edupulse@localhost:5432/edupulse
REDIS_URL=redis://localhost:6379/0
# Used only by the pytest suite (tests/conftest.py), never by the running
# app, so `make test` cannot write rows into your real local data. Docker
# Compose points this at a dedicated `edupulse_test` database created once by
# infrastructure/postgres/init/01-create-test-db.sql (fresh volumes only —
# see README for how to create it on an existing volume).
TEST_DATABASE_URL=postgresql+psycopg://edupulse:edupulse@localhost:5432/edupulse_test
TEST_REDIS_URL=redis://localhost:6379/15
# Comma-separated list of allowed CORS origins for local development.
API_CORS_ORIGINS=http://localhost:3000
# Secret used to sign auth tokens. MUST be replaced with a real random value
# before any non-local use. Never commit a real value here.
API_SECRET_KEY=change-me-in-local-env

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
